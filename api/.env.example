DATABASE_URL="postgresql://app:app@localhost:5432/gestao_de_obras_db"
# Obrigatório, 32+ caracteres aleatórios (sem ele o servidor não sobe). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Operador da plataforma criado pelo seed (npx prisma db seed): só nasce com uma senha de 12+
# caracteres escolhida por você; se o operador já existe, o seed não mexe na senha dele.
PLATFORM_ADMIN_EMAIL="admin@plataforma.local"
PLATFORM_ADMIN_PASSWORD=""
PLATFORM_ADMIN_NAME="Operador Plataforma"
