generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum OperatorStatus {
  ACTIVE
  INACTIVE
}

enum TenantUserStatus {
  ACTIVE
  INACTIVE
}

enum LicitacaoStatus {
  ACTIVE
  INACTIVE
}

enum CentroCustoStatus {
  ACTIVE
  INACTIVE
}

enum SolicitacaoServicoStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CONSOLIDATED
}

enum PedidoCompraStatus {
  DRAFT
  EM_REVISAO
  AGUARDANDO_APROVACAO
  APROVADO
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum PropriedadeTipo {
  TEXTO
  DATA
  VALOR
  BOOLEAN
  ITEM_LICITACAO
  ITENS_LICITACAO
}

enum PropriedadeProductionRole {
  NONE
  INICIO
  CONCLUSAO
}

model Entity {
  id                      String       @id @default(uuid())
  name                    String
  status                  EntityStatus @default(ACTIVE)
  cnpj                    String?      @unique
  email                   String?
  phone                   String?
  legalRepresentativeName String?      @map("legal_representative_name")
  uf                      String?      @db.Char(2)
  municipalityId          Int?         @map("municipality_id")
  municipalityName        String?      @map("municipality_name")
  address                 String?
  coatOfArmsUrl           String?      @map("coat_of_arms_url")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  auditLogs                     PlatformAuditLog[]
  tenantUsers                   TenantUser[]
  tenantAudits                  TenantAuditLog[]
  licitacoes                    Licitacao[]
  licitacaoItems                LicitacaoItem[]
  centrosCusto                  CentroCusto[]
  centroCustoPropriedades       CentroCustoPropriedade[]
  registrosDiarios              RegistroDiario[]
  centroCustoLicitacoes         CentroCustoLicitacao[]
  centroCustoPropriedadeConfigs CentroCustoPropriedadeConfig[]
  registroDiarioValores         RegistroDiarioValor[]
  registroDiarioValorItens      RegistroDiarioValorItem[]
  cadastrosAuxiliares           CadastroAuxiliar[]
  enderecosDescobertos          EnderecoDescoberto[]
  registroMidias                RegistroMidia[]
  equipes                       Equipe[]
  operadores                    Operador[]
  solicitacoesServico           SolicitacaoServico[]
  solicitacaoServicoItens       SolicitacaoServicoItem[]
  pedidosCompra                 PedidoCompra[]
  pedidoCompraItens             PedidoCompraItem[]
  pedidoCompraItemOrigens       PedidoCompraItemOrigem[]
  pedidoCompraRecebimentos      PedidoCompraRecebimento[]
  fornecedores                  Fornecedor[]
  sequencias                    Sequencia[]
  solicitacoesMunicipe          SolicitacaoMunicipe[]
  configuracaoObras             ConfiguracaoObras?
  usuarioServicos               UsuarioServico[]
  usuarioEquipes                UsuarioEquipe[]
  centrosDeCusto                CentroDeCusto[]
  orcamentos                    Orcamento[]
  contratos                     Contrato[]
  linksAcesso                   TenantUserLink[]
  servicoCampos                 ServicoCampo[]

  @@index([status])
  @@map("entities")
}

enum CadastroAuxiliarTipo {
  BAIRRO
  EQUIPE
  VEICULO
  EQUIPAMENTO
  MACROZONA
}

model CadastroAuxiliar {
  id          String               @id @default(uuid())
  entityId    String               @map("entity_id")
  tipo        CadastroAuxiliarTipo
  nome        String               @db.VarChar(150)
  ativo       Boolean              @default(true)
  ordem       Int                  @default(0)
  lat         Float?
  lng         Float?
  macrozonaId String?              @map("macrozona_id")
  /**
   * veículos e equipamentos: tipo (caminhão basculante, patrol…), placa e patrimônio
   */
  subtipo     String?              @db.VarChar(80)
  placa       String?              @db.VarChar(20)
  patrimonio  String?              @db.VarChar(40)
  /** veículos e equipamentos: tipo do cadastro de tipos (Veículos, Máquinas, Equipamentos, Móveis…) */
  tipoFrotaId String?              @map("tipo_frota_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  entity            Entity             @relation(fields: [entityId], references: [id])
  equipe            Equipe?
  macrozona         CadastroAuxiliar?  @relation("BairroMacrozona", fields: [macrozonaId], references: [id])
  bairros           CadastroAuxiliar[] @relation("BairroMacrozona")
  usuarios          TenantUser[]       @relation("UsuarioEquipe")
  usuariosEquipe    UsuarioEquipe[]    @relation("EquipeUsuarios")
  equipesComVeiculo Equipe[]           @relation("EquipeVeiculo")
  servicosFrota     ServicoFrota[]
  tipoFrota         TipoFrota?   @relation(fields: [tipoFrotaId], references: [id], onDelete: SetNull)

  @@unique([entityId, tipo, nome])
  @@index([entityId, tipo, ativo])
  @@index([macrozonaId])
  @@map("cadastros_auxiliares")
}

model PlatformOperator {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  status       OperatorStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  auditLogs PlatformAuditLog[]

  @@map("platform_operators")
}

model PlatformAuditLog {
  id            String   @id @default(uuid())
  operatorId    String
  entityId      String?
  action        String
  resource      String
  previousValue Json?
  newValue      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  operator PlatformOperator @relation(fields: [operatorId], references: [id])
  entity   Entity?          @relation(fields: [entityId], references: [id])

  @@index([entityId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

model TenantRole {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  permissions TenantRolePermission[]
  users       TenantUser[]

  @@map("tenant_roles")
}

model TenantPermission {
  id          String @id @default(uuid())
  code        String @unique
  description String
  module      String

  roles TenantRolePermission[]

  @@map("tenant_permissions")
}

model TenantRolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       TenantRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission TenantPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("tenant_role_permissions")
}

model TenantUser {
  id            String           @id @default(uuid())
  entityId      String           @map("entity_id")
  roleId        String           @map("role_id")
  name          String
  email         String
  passwordHash  String           @map("password_hash")
  status        TenantUserStatus @default(ACTIVE)
  isLiderEquipe Boolean          @default(false) @map("is_lider_equipe")
  /**
   * caixas marcadas na tela Acessos (o perfil é só o modelo que pré-marca)
   */
  acessos       String[]         @default([])
  adminGeral    Boolean          @default(false) @map("admin_geral")
  celular       String?          @db.VarChar(20)
  equipeId      String?          @map("equipe_id")
  /**
   * false enquanto a pessoa não criou a senha pelo link
   */
  senhaDefinida Boolean          @default(true) @map("senha_definida")
  lastLoginAt   DateTime?        @map("last_login_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  entity                          Entity                    @relation(fields: [entityId], references: [id])
  role                            TenantRole                @relation(fields: [roleId], references: [id])
  equipe                          CadastroAuxiliar?         @relation("UsuarioEquipe", fields: [equipeId], references: [id], onDelete: SetNull)
  linksAcesso                     TenantUserLink[]
  auditLogs                       TenantAuditLog[]
  licitacoesCreated               Licitacao[]               @relation("LicitacaoCreatedBy")
  licitacaoItemsCreated           LicitacaoItem[]           @relation("LicitacaoItemCreatedBy")
  centrosCustoCreated             CentroCusto[]             @relation("CentroCustoCreatedBy")
  propriedadesCreated             CentroCustoPropriedade[]  @relation("PropriedadeCreatedBy")
  registrosDiariosCreated         RegistroDiario[]          @relation("RegistroDiarioCreatedBy")
  registrosDiariosUpdated         RegistroDiario[]          @relation("RegistroDiarioUpdatedBy")
  equipesLideradas                Equipe[]
  solicitacoesServicoCreated      SolicitacaoServico[]      @relation("SolicitacaoServicoCreatedBy")
  pedidosCompraCreated            PedidoCompra[]            @relation("PedidoCompraCreatedBy")
  pedidoCompraRecebimentosCreated PedidoCompraRecebimento[] @relation("PedidoCompraRecebimentoCreatedBy")
  solicitacoesMunicipeAnalisadas  SolicitacaoMunicipe[]     @relation("SolicitacaoMunicipeAnalisadaPor")
  osAprovadas                     RegistroDiario[]          @relation("OSAprovadaPor")
  osExecutadas                    RegistroDiario[]          @relation("OSExecutadaPor")
  osFinalizadas                   RegistroDiario[]          @relation("OSFinalizadaPor")
  osRecusadas                     RegistroDiario[]          @relation("OSRecusadaPor")
  servicos                        UsuarioServico[]
  /**
   * equipes da pessoa (uma ou mais); equipeId acima fica como a principal
   */
  equipes                         UsuarioEquipe[]
  pedidosRevisados                PedidoCompra[]            @relation("PedidoRevisadoPor")
  pedidosAprovados                PedidoCompra[]            @relation("PedidoAprovadoPor")
  orcamentosCriados               Orcamento[]               @relation("OrcamentoCriadoPor")
  orcamentosRevisados             Orcamento[]               @relation("OrcamentoRevisadoPor")
  orcamentosAprovados             Orcamento[]               @relation("OrcamentoAprovadoPor")
  contratosCriados                Contrato[]                @relation("ContratoCriadoPor")
  aditivosCriados                 ContratoAditivo[]         @relation("AditivoCriadoPor")

  @@unique([entityId, email])
  @@index([entityId])
  @@index([status])
  @@map("tenant_users")
}

model Equipe {
  id          String   @id @default(uuid())
  entityId    String   @map("entity_id")
  cadastroId  String   @unique @map("cadastro_id")
  liderUserId String?  @map("lider_user_id")
  veiculoId   String?  @map("veiculo_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entity     Entity            @relation(fields: [entityId], references: [id])
  cadastro   CadastroAuxiliar  @relation(fields: [cadastroId], references: [id], onDelete: Cascade)
  veiculo    CadastroAuxiliar? @relation("EquipeVeiculo", fields: [veiculoId], references: [id], onDelete: SetNull)
  lider      TenantUser?       @relation(fields: [liderUserId], references: [id])
  operadores Operador[]

  @@index([entityId])
  @@map("equipes")
}

model Operador {
  id        String   @id @default(uuid())
  entityId  String   @map("entity_id")
  equipeId  String   @map("equipe_id")
  nome      String   @db.VarChar(150)
  cargo     String   @db.VarChar(100)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entity Entity @relation(fields: [entityId], references: [id])
  equipe Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)

  @@index([equipeId, ativo])
  @@index([entityId])
  @@map("operadores")
}

model TenantAuditLog {
  id            String   @id @default(uuid())
  entityId      String   @map("entity_id")
  userId        String?  @map("user_id")
  action        String
  resource      String
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  entity Entity      @relation(fields: [entityId], references: [id])
  user   TenantUser? @relation(fields: [userId], references: [id])

  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("tenant_audit_logs")
}

model Fornecedor {
  id           String   @id @default(uuid())
  entityId     String   @map("entity_id")
  razaoSocial  String   @map("razao_social") @db.VarChar(250)
  cnpj         String?  @db.VarChar(18)
  contato      String?  @db.VarChar(150)
  telefone     String?  @db.VarChar(30)
  email        String?  @db.VarChar(150)
  nomeFantasia String?  @map("nome_fantasia") @db.VarChar(250)
  endereco     String?  @db.VarChar(400)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  entity     Entity      @relation(fields: [entityId], references: [id])
  licitacoes Licitacao[]
  contratos  Contrato[]

  @@index([entityId, ativo])
  @@map("fornecedores")
}

model Licitacao {
  id              String          @id @default(uuid())
  entityId        String          @map("entity_id")
  identificacao   String          @db.VarChar(100)
  objeto          String          @db.VarChar(500)
  fornecedorId    String?         @map("fornecedor_id")
  numeroProcesso  String?         @map("numero_processo") @db.VarChar(60)
  modalidade      String?         @db.VarChar(80)
  tipo            String?         @db.VarChar(30)
  dataHomologacao DateTime?       @map("data_homologacao") @db.Date
  status          LicitacaoStatus @default(ACTIVE)
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  entity              Entity                 @relation(fields: [entityId], references: [id])
  createdBy           TenantUser             @relation("LicitacaoCreatedBy", fields: [createdByUserId], references: [id])
  fornecedor          Fornecedor?            @relation(fields: [fornecedorId], references: [id])
  items               LicitacaoItem[]
  centrosCusto        CentroCustoLicitacao[]
  solicitacoesServico SolicitacaoServico[]
  contratos           Contrato[]
  arquivos            DocumentoContratacao[]

  @@unique([entityId, identificacao])
  @@index([entityId, status])
  @@map("licitacoes")
}

model LicitacaoItem {
  id              String          @id @default(uuid())
  licitacaoId     String          @map("licitacao_id")
  entityId        String          @map("entity_id")
  categoria       String?         @db.VarChar(100)
  descricao       String          @db.VarChar(500)
  unidadeMedida   String          @map("unidade_medida") @db.VarChar(50)
  quantidade      Decimal?        @db.Decimal(15, 4)
  valorUnitario   Decimal?        @map("valor_unitario") @db.Decimal(15, 4)
  marca           String?         @db.VarChar(120)
  contratoId      String?         @map("contrato_id")
  loteId          String?         @map("lote_id")
  status          LicitacaoStatus @default(ACTIVE)
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  licitacao               Licitacao                 @relation(fields: [licitacaoId], references: [id])
  entity                  Entity                    @relation(fields: [entityId], references: [id])
  createdBy               TenantUser                @relation("LicitacaoItemCreatedBy", fields: [createdByUserId], references: [id])
  contrato                Contrato?                 @relation(fields: [contratoId], references: [id])
  lote                    ContratoLote?             @relation(fields: [loteId], references: [id])
  aditivoItens            ContratoAditivoItem[]
  registroValores         RegistroDiarioValorItem[]
  solicitacaoServicoItens SolicitacaoServicoItem[]
  pedidoCompraItens       PedidoCompraItem[]
  orcamentoItens          OrcamentoItem[]

  @@index([licitacaoId, status])
  @@index([entityId, licitacaoId])
  @@map("licitacao_items")
}

model CentroCusto {
  id                  String            @id @default(uuid())
  entityId            String            @map("entity_id")
  nome                String            @db.VarChar(200)
  dataPrevistaInicio  DateTime?         @map("data_prevista_inicio") @db.Date
  dataPrevistaFim     DateTime?         @map("data_prevista_fim") @db.Date
  dataRealizadaInicio DateTime?         @map("data_realizada_inicio") @db.Date
  dataRealizadaFim    DateTime?         @map("data_realizada_fim") @db.Date
  status              CentroCustoStatus @default(ACTIVE)
  createdByUserId     String            @map("created_by_user_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  entity                Entity                         @relation(fields: [entityId], references: [id])
  createdBy             TenantUser                     @relation("CentroCustoCreatedBy", fields: [createdByUserId], references: [id])
  licitacoes            CentroCustoLicitacao[]
  propriedadeConfigs    CentroCustoPropriedadeConfig[]
  registrosDiarios      RegistroDiario[]
  usuarios              UsuarioServico[]
  frota                 ServicoFrota[]
  centroDeCustoPadraoId String?                        @map("centro_de_custo_padrao_id")
  centroDeCustoPadrao   CentroDeCusto?                 @relation("ServicoCentroPadrao", fields: [centroDeCustoPadraoId], references: [id], onDelete: SetNull)
  /**
   * ── Ficha do serviço (passo 6). Enquanto fichaSalvaEm for nulo, valem os padrões do código ──
   */
  tipoServico           String?                        @map("tipo_servico") @db.VarChar(20)
  cor                   String?                        @db.VarChar(9)
  prazoDias             Int?                           @map("prazo_dias")
  subtipos              String[]                       @default([])
  municipePode          Boolean?                       @map("municipe_pode")
  nomeMunicipe          String?                        @map("nome_municipe") @db.VarChar(200)
  fichaSalvaEm          DateTime?                      @map("ficha_salva_em")
  /// Campos comuns de toda OS ajustados para este serviço: onde acontece, origem, equipe, veículo, fotos, observações
  camposComuns          Json?                          @map("campos_comuns")
  camposFicha           ServicoCampo[]

  @@unique([entityId, nome])
  @@index([entityId, status])
  @@map("centros_custo")
}

model CentroCustoLicitacao {
  centroCustoId String   @map("centro_custo_id")
  licitacaoId   String   @map("licitacao_id")
  entityId      String   @map("entity_id")
  createdAt     DateTime @default(now()) @map("created_at")

  centroCusto CentroCusto @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)
  licitacao   Licitacao   @relation(fields: [licitacaoId], references: [id])
  entity      Entity      @relation(fields: [entityId], references: [id])

  @@id([centroCustoId, licitacaoId])
  @@map("centro_custo_licitacoes")
}

model CentroCustoPropriedade {
  id              String            @id @default(uuid())
  entityId        String            @map("entity_id")
  nome            String            @db.VarChar(100)
  tipo            PropriedadeTipo
  status          CentroCustoStatus @default(ACTIVE)
  createdByUserId String            @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  entity    Entity                         @relation(fields: [entityId], references: [id])
  createdBy TenantUser                     @relation("PropriedadeCreatedBy", fields: [createdByUserId], references: [id])
  configs   CentroCustoPropriedadeConfig[]
  valores   RegistroDiarioValor[]

  @@unique([entityId, nome])
  @@index([entityId, status])
  @@map("centro_custo_propriedades")
}

model CentroCustoPropriedadeConfig {
  id             String                    @id @default(uuid())
  centroCustoId  String                    @map("centro_custo_id")
  propriedadeId  String                    @map("propriedade_id")
  entityId       String                    @map("entity_id")
  columnOrder    Int                       @map("column_order")
  productionRole PropriedadeProductionRole @default(NONE) @map("production_role")
  active         Boolean                   @default(true)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  centroCusto CentroCusto            @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)
  propriedade CentroCustoPropriedade @relation(fields: [propriedadeId], references: [id])
  entity      Entity                 @relation(fields: [entityId], references: [id])

  @@unique([centroCustoId, propriedadeId])
  @@index([centroCustoId, active, columnOrder])
  @@map("centro_custo_propriedade_configs")
}

model RegistroDiario {
  id                    String   @id @default(uuid())
  centroCustoId         String   @map("centro_custo_id")
  entityId              String   @map("entity_id")
  data                  DateTime @db.Date
  lat                   Float?
  lng                   Float?
  enderecoGeocodificado String?  @map("endereco_geocodificado")
  createdByUserId       String   @map("created_by_user_id")
  updatedByUserId       String?  @map("updated_by_user_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  centroCusto         CentroCusto           @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)
  entity              Entity                @relation(fields: [entityId], references: [id])
  createdBy           TenantUser            @relation("RegistroDiarioCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy           TenantUser?           @relation("RegistroDiarioUpdatedBy", fields: [updatedByUserId], references: [id])
  valores             RegistroDiarioValor[]
  midias              RegistroMidia[]
  solicitacaoMunicipe SolicitacaoMunicipe?

  numeroOS        String?        @map("numero_os") @db.VarChar(20)
  etapa           EtapaOS        @default(REGISTRADA)
  aprovadoEm      DateTime?      @map("aprovado_em")
  aprovadoPorId   String?        @map("aprovado_por_id")
  executadoEm     DateTime?      @map("executado_em")
  executadoPorId  String?        @map("executado_por_id")
  finalizadoEm    DateTime?      @map("finalizado_em")
  finalizadoPorId String?        @map("finalizado_por_id")
  aprovadoPor     TenantUser?    @relation("OSAprovadaPor", fields: [aprovadoPorId], references: [id])
  executadoPor    TenantUser?    @relation("OSExecutadaPor", fields: [executadoPorId], references: [id])
  finalizadoPor   TenantUser?    @relation("OSFinalizadaPor", fields: [finalizadoPorId], references: [id])
  centroDeCustoId String?        @map("centro_de_custo_id")
  centroDeCusto   CentroDeCusto? @relation(fields: [centroDeCustoId], references: [id], onDelete: SetNull)

  /// Central de Solicitações: de onde veio e, se o responsável recusou, por quê
  origem        OrigemOS    @default(ESCRITORIO)
  recusadoEm    DateTime?   @map("recusado_em")
  recusadoPorId String?     @map("recusado_por_id")
  motivoRecusa  String?     @map("motivo_recusa")
  recusadoPor   TenantUser? @relation("OSRecusadaPor", fields: [recusadoPorId], references: [id])

  @@unique([entityId, numeroOS])
  @@index([entityId, etapa])
  @@index([entityId, origem, etapa])
  @@index([centroCustoId, data])
  @@index([entityId, centroCustoId, data])
  @@index([entityId, lat, lng])
  @@map("registros_diarios")
}

model RegistroMidia {
  id               String   @id @default(uuid())
  registroDiarioId String   @map("registro_diario_id")
  entityId         String   @map("entity_id")
  tipo             String   @db.VarChar(10)
  nomeArquivo      String   @map("nome_arquivo") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  tamanhoBytes     Int      @map("tamanho_bytes")
  dados            Bytes
  createdAt        DateTime @default(now()) @map("created_at")

  registroDiario RegistroDiario @relation(fields: [registroDiarioId], references: [id], onDelete: Cascade)
  entity         Entity         @relation(fields: [entityId], references: [id])

  @@index([registroDiarioId])
  @@map("registro_midias")
}

model RegistroDiarioValor {
