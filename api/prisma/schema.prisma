}

/**
 * ── Central do Munícipe: pedidos feitos pelo link / QR Code ──
 */
enum SolicitacaoMunicipeStatus {
  NOVA
  CONVERTIDA
  RECUSADA
}

model SolicitacaoMunicipe {
  id               String                    @id @default(uuid())
  entityId         String                    @map("entity_id")
  protocolo        String                    @db.VarChar(20)
  categoria        String                    @db.VarChar(80)
  categoriaNome    String                    @map("categoria_nome") @db.VarChar(160)
  descricao        String                    @db.VarChar(2000)
  bairro           String                    @db.VarChar(150)
  logradouro       String                    @db.VarChar(300)
  referencia       String?                   @db.VarChar(300)
  lat              Float?
  lng              Float?
  precisaoM        Float?                    @map("precisao_m")
  nome             String                    @db.VarChar(160)
  telefone         String                    @db.VarChar(30)
  cpf              String?                   @db.VarChar(14)
  email            String?                   @db.VarChar(160)
  status           SolicitacaoMunicipeStatus @default(NOVA)
  motivoRecusa     String?                   @map("motivo_recusa") @db.VarChar(1000)
  registroDiarioId String?                   @unique @map("registro_diario_id")
  analisadoPorId   String?                   @map("analisado_por_id")
  analisadoEm      DateTime?                 @map("analisado_em")
  origemIp         String?                   @map("origem_ip") @db.VarChar(64)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

