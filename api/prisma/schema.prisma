  enviadoRevisaoEm DateTime?          @map("enviado_revisao_em")
  revisadoEm       DateTime?          @map("revisado_em")
  revisadoPorId    String?            @map("revisado_por_id")
  aprovadoEm       DateTime?          @map("aprovado_em")
  aprovadoPorId    String?            @map("aprovado_por_id")
  devolvidoEm      DateTime?          @map("devolvido_em")
  devolvidoMotivo  String?            @map("devolvido_motivo") @db.VarChar(1000)
  revisadoPor      TenantUser?        @relation("PedidoRevisadoPor", fields: [revisadoPorId], references: [id])
  aprovadoPor      TenantUser?        @relation("PedidoAprovadoPor", fields: [aprovadoPorId], references: [id])
  orcamentoId      String?            @map("orcamento_id")
