  analisadoPor   TenantUser?               @relation("SolicitacaoMunicipeAnalisadaPor", fields: [analisadoPorId], references: [id])
  fotos          SolicitacaoMunicipeFoto[]

  @@unique([entityId, protocolo])
  @@index([entityId, status, createdAt])
  @@map("solicitacoes_municipe")
}

model SolicitacaoMunicipeFoto {
  id            String   @id @default(uuid())
  solicitacaoId String   @map("solicitacao_id")
  mimeType      String   @map("mime_type") @db.VarChar(100)
  tamanhoBytes  Int      @map("tamanho_bytes")
  dados         Bytes
  createdAt     DateTime @default(now()) @map("created_at")

  solicitacao SolicitacaoMunicipe @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@index([solicitacaoId])
  @@map("solicitacao_municipe_fotos")
}

/**
 * ── Etapas da ordem de serviço ──
 */
/// De onde veio a OS: escritório (computador), campo (celular do fiscal/coordenador) ou munícipe (link/QR)
enum OrigemOS {
  ESCRITORIO
  CAMPO
  MUNICIPE
}

enum EtapaOS {
  AGUARDANDO_APROVACAO
  REGISTRADA
  EXECUTADA
  FINALIZADA
  CANCELADA
}

/**
 * ── Regras da secretaria (configuráveis por entidade) ──
 */
model ConfiguracaoObras {
  entityId                    String   @id @map("entity_id")
  /// Sempre ligado: toda OS passa pelo crivo do responsável na Central de Solicitações
  exigeAprovacaoOS            Boolean  @default(true) @map("exige_aprovacao_os")
  aprovadores                 String[] @default(["ADMIN", "COORDENADOR"])
  exigeConferencia            Boolean  @default(true) @map("exige_conferencia")
  conferentes                 String[] @default(["ADMIN", "COORDENADOR"])
  metaDias                    Int      @default(5) @map("meta_dias")
  exigeAprovacaoCompra        Boolean  @default(true) @map("exige_aprovacao_compra")
  revisoresCompra             String[] @default(["ADMIN", "COORDENADOR"]) @map("revisores_compra")
  aprovadoresCompra           String[] @default(["ADMIN"]) @map("aprovadores_compra")
  /// Fluxo e aprovações: revisão do pedido separada da aprovação
  exigeRevisaoCompra          Boolean  @default(true) @map("exige_revisao_compra")
  /// De onde vem a OS que precisa de aprovação: ESCRITORIO, MUNICIPE, CAMPO
  aprovacaoOrigens            String[] @default(["ESCRITORIO", "MUNICIPE", "CAMPO"]) @map("aprovacao_origens")
  /// Quem deu a baixa não pode conferir a própria baixa
  conferenciaPropriaBloqueada Boolean  @default(true) @map("conferencia_propria_bloqueada")
  /// O pedido só pode nascer de um orçamento
  pedidoSoDeOrcamento         Boolean  @default(false) @map("pedido_so_de_orcamento")
  /// Origens da demanda (Ouvidoria, Munícipe, Vereador…): uma lista só, vale para todos os serviços
  origensDemanda              String[] @default(["Ouvidoria", "Vistoria Própria", "Munícipe", "Vereador", "Secretaria", "Outros"]) @map("origens_demanda")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  entity Entity @relation(fields: [entityId], references: [id])

  @@map("configuracoes_obras")
}

/**
 * ── Equipes de cada usuário (uma ou mais) ──
 * Obrigatória para todos, menos Administrador, Secretário(a) e Coordenador.
 */
model UsuarioEquipe {
  userId    String   @map("user_id")
  equipeId  String   @map("equipe_id")
  entityId  String   @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   TenantUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipe CadastroAuxiliar @relation("EquipeUsuarios", fields: [equipeId], references: [id], onDelete: Cascade)
  entity Entity           @relation(fields: [entityId], references: [id])

  @@id([userId, equipeId])
  @@index([entityId])
  @@index([equipeId])
  @@map("usuario_equipes")
}

/**
 * ── Serviços que cada usuário atende (nenhum = nenhum; ver todos é a caixa "Ver todos os serviços") ──
 */
model UsuarioServico {
  userId        String   @map("user_id")
  centroCustoId String   @map("centro_custo_id")
  entityId      String   @map("entity_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        TenantUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  centroCusto CentroCusto @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)
  entity      Entity      @relation(fields: [entityId], references: [id])

  @@id([userId, centroCustoId])
  @@index([entityId])
  @@map("usuario_servicos")
}

/**
 * ── Tipos de veículo/equipamento (Veículos, Máquinas, Equipamentos, Móveis…), cadastrados pelo próprio órgão ──
 */
model TipoFrota {
  id        String   @id @default(uuid())
  entityId  String   @map("entity_id")
  nome      String   @db.VarChar(80)
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  itens CadastroAuxiliar[]

  @@unique([entityId, nome])
  @@index([entityId])
  @@map("tipos_frota")
}

/**
 * ── Veículos e equipamentos que cada serviço usa (todo veículo/equipamento tem ao menos um) ──
 * Marcado tanto no cadastro do veículo/equipamento quanto na ficha do serviço: é o mesmo vínculo.
 */
model ServicoFrota {
  servicoId  String   @map("servico_id")
  cadastroId String   @map("cadastro_id")
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  servico  CentroCusto      @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  cadastro CadastroAuxiliar @relation(fields: [cadastroId], references: [id], onDelete: Cascade)

  @@id([servicoId, cadastroId])
  @@index([cadastroId])
  @@index([entityId])
  @@map("servico_frota")
}

/**
 * ── Centro de custo DE VERDADE: onde a despesa é apropriada ──
 * Atenção: o model antigo `CentroCusto` (tabela centros_custo) representa, na prática,
 * o SERVIÇO (Tapa-Buracos, Roçagem…). Este aqui é o centro de custo contábil.
 */
enum TipoCentroDeCusto {
  SECRETARIA
  SETOR
  PROGRAMA
  OBRA
  OUTRO
}

model CentroDeCusto {
  id          String            @id @default(uuid())
  entityId    String            @map("entity_id")
  codigo      String            @db.VarChar(20)
  nome        String            @db.VarChar(200)
  tipo        TipoCentroDeCusto @default(SETOR)
  descricao   String?           @db.VarChar(1000)
  responsavel String?           @db.VarChar(160)
  ativo       Boolean           @default(true)
  paiId       String?           @map("pai_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  entity           Entity                   @relation(fields: [entityId], references: [id])
  pai              CentroDeCusto?           @relation("CentroDeCustoHierarquia", fields: [paiId], references: [id], onDelete: SetNull)
  filhos           CentroDeCusto[]          @relation("CentroDeCustoHierarquia")
  servicosPadrao   CentroCusto[]            @relation("ServicoCentroPadrao")
  registros        RegistroDiario[]
  solicitacaoItens SolicitacaoServicoItem[]
  origensPedido    PedidoCompraItemOrigem[]
  orcamentos       Orcamento[]
  orcamentoItens   OrcamentoItem[]

  @@unique([entityId, codigo])
  @@index([entityId, ativo])
  @@map("centros_de_custo")
}

/**
 * ── Orçamentação: fotos do local + materiais dos contratos → pedido de compra ──
 */
enum OrcamentoStatus {
  RASCUNHO
  EM_REVISAO
  AGUARDANDO_APROVACAO
  APROVADO
  CONVERTIDO
  CANCELADO
}

model Orcamento {
  id              String          @id @default(uuid())
  entityId        String          @map("entity_id")
  numero          String          @db.VarChar(20)
  titulo          String          @db.VarChar(200)
  descricao       String?         @db.VarChar(2000)
  bairro          String?         @db.VarChar(150)
  logradouro      String?         @db.VarChar(300)
  lat             Float?
  lng             Float?
  servicoSlug     String?         @map("servico_slug") @db.VarChar(80)
  servicoNome     String?         @map("servico_nome") @db.VarChar(160)
  centroDeCustoId String?         @map("centro_de_custo_id")
  status          OrcamentoStatus @default(RASCUNHO)
  enviadoEm       DateTime?       @map("enviado_em")
  revisadoEm      DateTime?       @map("revisado_em")
  revisadoPorId   String?         @map("revisado_por_id")
  aprovadoEm      DateTime?       @map("aprovado_em")
  aprovadoPorId   String?         @map("aprovado_por_id")
  devolvidoEm     DateTime?       @map("devolvido_em")
  devolvidoMotivo String?         @map("devolvido_motivo") @db.VarChar(1000)
  convertidoEm    DateTime?       @map("convertido_em")
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  entity        Entity          @relation(fields: [entityId], references: [id])
  centroDeCusto CentroDeCusto?  @relation(fields: [centroDeCustoId], references: [id], onDelete: SetNull)
  createdBy     TenantUser      @relation("OrcamentoCriadoPor", fields: [createdByUserId], references: [id])
  revisadoPor   TenantUser?     @relation("OrcamentoRevisadoPor", fields: [revisadoPorId], references: [id])
  aprovadoPor   TenantUser?     @relation("OrcamentoAprovadoPor", fields: [aprovadoPorId], references: [id])
  itens         OrcamentoItem[]
  fotos         OrcamentoFoto[]
  pedidos       PedidoCompra[]

  @@unique([entityId, numero])
  @@index([entityId, status])
  @@map("orcamentos")
}

model OrcamentoItem {
  id                    String   @id @default(uuid())
  orcamentoId           String   @map("orcamento_id")
  licitacaoItemId       String   @map("licitacao_item_id")
  descricaoSnapshot     String   @map("descricao_snapshot") @db.VarChar(500)
  unidadeMedidaSnapshot String   @map("unidade_medida_snapshot") @db.VarChar(50)
  valorUnitarioSnapshot Decimal  @map("valor_unitario_snapshot") @db.Decimal(15, 4)
  quantidade            Decimal  @db.Decimal(15, 4)
  valorTotal            Decimal  @map("valor_total") @db.Decimal(15, 4)
  servicoSlug           String?  @map("servico_slug") @db.VarChar(80)
  servicoNome           String?  @map("servico_nome") @db.VarChar(160)
  centroDeCustoId       String?  @map("centro_de_custo_id")
  createdAt             DateTime @default(now()) @map("created_at")

  orcamento     Orcamento      @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  licitacaoItem LicitacaoItem  @relation(fields: [licitacaoItemId], references: [id])
  centroDeCusto CentroDeCusto? @relation(fields: [centroDeCustoId], references: [id], onDelete: SetNull)

  @@index([orcamentoId])
  @@map("orcamento_itens")
}

model OrcamentoFoto {
  id           String   @id @default(uuid())
  orcamentoId  String   @map("orcamento_id")
  nomeArquivo  String   @map("nome_arquivo") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  tamanhoBytes Int      @map("tamanho_bytes")
  dados        Bytes
  createdAt    DateTime @default(now()) @map("created_at")

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
  @@map("orcamento_fotos")
}

/**
 * ── Contratos da licitação (padrão Object): contrato → lotes → itens, aditivos ──
 */
enum AditivoTipo {
  PRAZO
  VALOR
  QUANTIDADE
}

model Contrato {
  id               String          @id @default(uuid())
  entityId         String          @map("entity_id")
  licitacaoId      String          @map("licitacao_id")
  numero           String          @db.VarChar(60)
  fornecedorId     String?         @map("fornecedor_id")
  vigenciaDe       DateTime        @map("vigencia_de") @db.Date
  vigenciaAte      DateTime        @map("vigencia_ate") @db.Date
  vigenciaOriginal DateTime?       @map("vigencia_original") @db.Date
  valor            Decimal?        @db.Decimal(15, 2)
  status           LicitacaoStatus @default(ACTIVE)
  createdByUserId  String          @map("created_by_user_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  entity     Entity                 @relation(fields: [entityId], references: [id])
  licitacao  Licitacao              @relation(fields: [licitacaoId], references: [id])
  fornecedor Fornecedor?            @relation(fields: [fornecedorId], references: [id])
  createdBy  TenantUser             @relation("ContratoCriadoPor", fields: [createdByUserId], references: [id])
  lotes      ContratoLote[]
  itens      LicitacaoItem[]
  aditivos   ContratoAditivo[]
  arquivos   DocumentoContratacao[]

  @@unique([licitacaoId, numero])
  @@index([entityId, vigenciaAte])
  @@map("contratos")
}

model ContratoLote {
  id         String   @id @default(uuid())
  contratoId String   @map("contrato_id")
  numero     String   @db.VarChar(20)
  descricao  String?  @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at")

  contrato Contrato          @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  itens    LicitacaoItem[]
  aditivos ContratoAditivo[]

  @@unique([contratoId, numero])
  @@map("contrato_lotes")
}

model ContratoAditivo {
  id               String      @id @default(uuid())
  entityId         String      @map("entity_id")
  contratoId       String      @map("contrato_id")
  numero           String      @db.VarChar(40)
  tipo             AditivoTipo
  dataPublicacao   DateTime    @map("data_publicacao") @db.Date
  vigenciaAnterior DateTime?   @map("vigencia_anterior") @db.Date
  novaVigencia     DateTime?   @map("nova_vigencia") @db.Date
  percentual       Decimal?    @db.Decimal(7, 4)
  loteId           String?     @map("lote_id")
  valorAditivado   Decimal     @default(0) @map("valor_aditivado") @db.Decimal(15, 2)
  observacao       String?     @db.VarChar(1000)
  createdByUserId  String      @map("created_by_user_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  contrato  Contrato               @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  lote      ContratoLote?          @relation(fields: [loteId], references: [id], onDelete: SetNull)
  createdBy TenantUser             @relation("AditivoCriadoPor", fields: [createdByUserId], references: [id])
  itens     ContratoAditivoItem[]
  arquivos  DocumentoContratacao[]

  @@unique([contratoId, numero])
  @@map("contrato_aditivos")
}

/**
 * O que cada aditivo mudou em cada item (para saber de onde veio o saldo e o preço)
 */
model ContratoAditivoItem {
  id                 String   @id @default(uuid())
  aditivoId          String   @map("aditivo_id")
  licitacaoItemId    String   @map("licitacao_item_id")
  quantidadeAnterior Decimal? @map("quantidade_anterior") @db.Decimal(15, 4)
  quantidadeNova     Decimal? @map("quantidade_nova") @db.Decimal(15, 4)
  valorAnterior      Decimal? @map("valor_anterior") @db.Decimal(15, 4)
  valorNovo          Decimal? @map("valor_novo") @db.Decimal(15, 4)

  aditivo ContratoAditivo @relation(fields: [aditivoId], references: [id], onDelete: Cascade)
  item    LicitacaoItem   @relation(fields: [licitacaoItemId], references: [id])

  @@index([aditivoId])
  @@map("contrato_aditivo_itens")
}

/**
 * PDFs da contratação: edital/ata (licitação), contrato, aditivo
 */
model DocumentoContratacao {
  id           String   @id @default(uuid())
  entityId     String   @map("entity_id")
  licitacaoId  String?  @map("licitacao_id")
  contratoId   String?  @map("contrato_id")
  aditivoId    String?  @map("aditivo_id")
  nomeArquivo  String   @map("nome_arquivo") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  tamanhoBytes Int      @map("tamanho_bytes")
  dados        Bytes
  createdAt    DateTime @default(now()) @map("created_at")

  licitacao Licitacao?       @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  contrato  Contrato?        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  aditivo   ContratoAditivo? @relation(fields: [aditivoId], references: [id], onDelete: Cascade)

  @@index([licitacaoId])
  @@index([contratoId])
  @@map("documentos_contratacao")
}

/**
 * ── Link para a pessoa criar a própria senha (48 h, uso único) ──
 * Só o hash do token fica no banco.
 */
model TenantUserLink {
  id          String    @id @default(uuid())
  entityId    String    @map("entity_id")
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm    DateTime  @map("expira_em")
  usadoEm     DateTime? @map("usado_em")
  criadoPorId String?   @map("criado_por_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  entity Entity     @relation(fields: [entityId], references: [id])
  user   TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("tenant_user_links")
}

/**
 * ── Campos que o fiscal preenche só neste serviço (ficha do serviço) ──
 * Os campos de toda OS (bairro, origem, equipe, fotos…) não ficam aqui.
 */
model ServicoCampo {
  id          String   @id @default(uuid())
  entityId    String   @map("entity_id")
  servicoId   String   @map("servico_id")
  nome        String   @db.VarChar(120)
  detalhe     String?  @db.VarChar(300)
  tipo        String   @db.VarChar(20) // TEXTO | LISTA | NUMERO | SIM_NAO
  opcoes      String[] @default([])
  momento     String   @db.VarChar(10) // ABERTURA | BAIXA
  obrigatorio Boolean  @default(false)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entity  Entity      @relation(fields: [entityId], references: [id])
  servico CentroCusto @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([servicoId, ordem])
  @@map("servico_campos")
}
